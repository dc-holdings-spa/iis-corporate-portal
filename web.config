<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings file="App_Data\arena.config">
    <add key="SITE_NAME" value="Corporate Portal" />
    <add key="SITE_TAGLINE" value="Document Portal" />
    <add key="FOOTER_LABEL" value="Internal Document Management System v3.2.1" />
  </appSettings>

  <system.web>
    <!-- 50 MB upload limit, 5-minute timeout -->
    <httpRuntime maxRequestLength="51200" executionTimeout="300"
                 enableVersionHeader="false"
                 requestValidationMode="4.0" />
    <compilation debug="false" targetFramework="4.0" />

    <!-- No stack traces / ASP.NET version to remote clients -->
    <customErrors mode="RemoteOnly" />

    <!-- Cookie hardening -->
    <httpCookies httpOnlyCookies="true" />

    <!-- Keep ASP.NET request validation active -->
    <pages validateRequest="true" />
  </system.web>

  <system.webServer>
    <!-- ── Directory browsing OFF ──────────────────────────────────────── -->
    <directoryBrowse enabled="false" />

    <!-- ── Strip revealing response headers ────────────────────────────── -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- ── Request filtering ───────────────────────────────────────────── -->
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="52428800" />

        <!-- Only GET, POST, HEAD — deny PUT, DELETE, OPTIONS, etc. -->
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="HEAD" allowed="true" />
        </verbs>

        <!-- Hide .git and App_Data from all requests -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment="App_Data" />
        </hiddenSegments>

        <!-- Block source / config files from being served -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".cs" allowed="false" />
          <add fileExtension=".csproj" allowed="false" />
          <add fileExtension=".sln" allowed="false" />
          <add fileExtension=".mdf" allowed="false" />
          <add fileExtension=".ldf" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- ── Error pages: generic for remote, detailed only on localhost ── -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto" />
  </system.webServer>

  <!-- ═══════════════════════════════════════════════════════════════════
       uploads/ — SAFE: static files ONLY, no server-side code execution.
       The vuln plugin removes this entire block when it replaces web.config.
       ═══════════════════════════════════════════════════════════════════ -->
  <location path="uploads">
    <system.webServer>
      <!-- Kill every inherited handler, allow only StaticFileModule -->
      <handlers>
        <clear />
        <add name="StaticFileOnly" path="*" verb="GET,HEAD"
             modules="StaticFileModule"
             resourceType="Either"
             requireAccess="Read" />
      </handlers>

      <!-- Block executable / server-side extensions from being requested -->
      <security>
        <requestFiltering>
          <fileExtensions allowUnlisted="true">
            <add fileExtension=".aspx" allowed="false" />
            <add fileExtension=".ashx" allowed="false" />
            <add fileExtension=".asmx" allowed="false" />
            <add fileExtension=".asp" allowed="false" />
            <add fileExtension=".config" allowed="false" />
            <add fileExtension=".cs" allowed="false" />
            <add fileExtension=".exe" allowed="false" />
            <add fileExtension=".dll" allowed="false" />
            <add fileExtension=".bat" allowed="false" />
            <add fileExtension=".cmd" allowed="false" />
            <add fileExtension=".ps1" allowed="false" />
            <add fileExtension=".vbs" allowed="false" />
            <add fileExtension=".wsf" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
